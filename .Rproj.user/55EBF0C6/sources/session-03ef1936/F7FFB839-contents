-query /data/Ab_4denovo_CLC6_a.fa \

-db /home/shared/8TB_HDD_02/cberry1/blastdb/uniprot_sprot_r2025_01 \

-out /output/Ab_4-uniprot_blastx.tab \

-evalue 1E-20 \

-num_threads 1 \

-max_target_seqs 1 \

-outfmt 6
